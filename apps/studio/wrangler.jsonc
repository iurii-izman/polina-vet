{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "polina-vet-studio",
  "compatibility_date": "2026-09-04",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "studio-polina-vet.aipipeline.cc", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
}
