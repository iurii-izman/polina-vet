{
  "name": "@polina-vet/studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "sanity start",
    "build": "sanity build",
    "typegen": "sanity schema extract --force && sanity typegen generate",
    "seed:safe": "sanity exec scripts/seed-safe.ts --with-user-token",
    "seed:m5": "sanity exec scripts/seed-m5.ts --with-user-token",
    "seed:m6": "sanity exec scripts/seed-m6.ts --with-user-token",
    "verify:remote": "sanity exec scripts/verify-remote.mjs",
    "check": "pnpm typegen && tsc --noEmit"
  },
  "dependencies": {
    "@sanity/vision": "^6.12.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sanity": "^6.12.0",
    "styled-components": "^6.5.3"
  },
  "devDependencies": {
    "@sanity/client": "^8.4.0",
    "typescript": "^6.0.3"
  }
}
