{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "polina-vet-production",
  "compatibility_date": "2026-09-04",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "lina.md", "custom_domain": true }],
  "assets": { "directory": "./dist", "html_handling": "force-trailing-slash" },
}
