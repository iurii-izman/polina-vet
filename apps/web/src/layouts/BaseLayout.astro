---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { localeFromPath, staticAlternates, ui, type Locale } from '../lib/i18n';
import { getSiteSettings } from '../lib/sanity/content';
import { getDraftModeProps } from '../lib/sanity/draft-mode';
import SanityVisualEditing from 'polina-vet-preview/visual-editing';
import DisableDraftMode from 'polina-vet-preview/disable-draft-mode';
import { absoluteUrl, robotsForPage, siteIndexable, siteUrl } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  robots?: string;
  locale?: Locale;
  alternates?: Partial<Record<Locale, string | null>>;
}

const { title, description, robots, alternates } = Astro.props;
const locale = Astro.props.locale ?? localeFromPath(Astro.url.pathname);
const { perspectiveCookie } = import.meta.env.MODE === 'preview' ? await getDraftModeProps(Astro.cookies) : { perspectiveCookie: undefined };
const siteSettings = await getSiteSettings(perspectiveCookie);
const siteTitle = siteSettings?.title ?? 'POLINA VET';
const strings = ui[locale];
const resolvedDescription = description ?? strings.description;
const draftMode = Boolean(perspectiveCookie);
const resolvedAlternates = alternates ?? staticAlternates(Astro.url.pathname);
const analyticsDomain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN?.trim();
const analyticsEnabled = analyticsDomain && import.meta.env.DEPLOYMENT_TARGET === 'production' && import.meta.env.SITE_INDEXABLE === 'true';
if (draftMode) Astro.response.headers.set('Cache-Control', 'private, no-store');
const resolvedRobots = robotsForPage(robots, draftMode);
if (!siteIndexable || draftMode) {
  Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow, noarchive');
}
---

<!doctype html>
<html lang={locale} data-analytics-domain={analyticsDomain} data-analytics-enabled={analyticsEnabled ? 'true' : 'false'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="description" content={resolvedDescription} />
    <meta name="robots" content={resolvedRobots} />
    <link rel="canonical" href={absoluteUrl(Astro.url.pathname)} />
    <meta property="og:url" content={absoluteUrl(Astro.url.pathname)} />
    <meta property="og:title" content={`${title} — ${siteTitle}`} />
    <meta property="og:description" content={resolvedDescription} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: siteTitle,
      url: siteUrl.toString(),
      inLanguage: locale,
    })} />
    {Object.entries(resolvedAlternates).map(([lang, href]) => href && <link rel="alternate" hreflang={lang} href={absoluteUrl(href)} />)}
    {siteIndexable && <link rel="alternate" hreflang="x-default" href={absoluteUrl(staticAlternates('/ru/')?.ru ?? '/ru/')} />}
    <meta name="color-scheme" content="light" />
    <script src="/nav.js" defer></script>
    {analyticsEnabled && <script is:inline async src="https://plausible.io/js/script.js" data-domain={analyticsDomain}></script>}
    <script is:inline src="/analytics.js" defer></script>
    <title>{title} — {siteTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{strings.skip}</a>
    <SiteHeader locale={locale} alternates={resolvedAlternates} />
    <main id="main-content" class="site-main" tabindex="-1">
      <slot />
    </main>
    <Footer locale={locale} />
    {draftMode && <><SanityVisualEditing client:only="react" /><DisableDraftMode client:only="react" /></>}
  </body>
</html>
