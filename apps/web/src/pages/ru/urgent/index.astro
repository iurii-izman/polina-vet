---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import UrgentBoundary from '../../../components/UrgentBoundary.astro';
import { route } from '../../../lib/i18n';
---

<BaseLayout title="Срочно: что делать" locale="ru">
  <section class="page-intro container"><p class="eyebrow">Срочно: что делать</p><h1>Состояние животного кажется срочным?</h1><p class="lead">Выберите тип животного. Вы увидите признаки, при которых не стоит откладывать получение ветеринарной помощи, и что можно безопасно сделать до обращения.</p><UrgentBoundary /></section>
  <section class="container gateway-grid" aria-label="Выбор срочного маршрута">
    <a class="gateway gateway--pet" href={route.petUrgent('ru')}><span class="eyebrow">Домашнее животное</span><h2>Собака или кошка</h2><p>Срочный маршрут для домашнего животного.</p><span class="gateway__action">Перейти <b aria-hidden="true">→</b></span></a>
    <a class="gateway gateway--farm" href={route.farmUrgent('ru')}><span class="eyebrow">Сельскохозяйственное животное</span><h2>Хозяйство</h2><p>Срочный маршрут с учётом группы и условий.</p><span class="gateway__action">Перейти <b aria-hidden="true">→</b></span></a>
  </section>
</BaseLayout>
