---
import ArticlePage from '../../../components/ArticlePage.astro';
import { publishedArticleDetailQuery } from '../../../lib/queries';
import { getRussianArticlePaths } from '../../../lib/articlePaths';
import { sanityClient } from '../../../lib/sanity';
export async function getStaticPaths() { return (await getRussianArticlePaths()).filter((entry: Awaited<ReturnType<typeof getRussianArticlePaths>>[number]) => entry.props.domain === 'farm'); }
const { slug } = Astro.params;
const article = await sanityClient.fetch(publishedArticleDetailQuery, { language: 'ru', slug });
if (!article || article.primaryDomain !== 'farm') throw new Error(`Published article not found: ${slug}`);
---
<ArticlePage article={article} now={new Date().toISOString().slice(0, 10)} />
