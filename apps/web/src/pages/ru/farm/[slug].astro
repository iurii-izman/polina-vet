---
import ArticlePage from '../../../components/ArticlePage.astro';
import { ARTICLE_DETAIL_QUERY } from '../../../lib/sanity/queries';
import type { ARTICLE_DETAIL_QUERY_RESULT } from '../../../lib/sanity/sanity.types';
import { fetchSanity } from '../../../lib/sanity/load-query';
import { getDraftModeProps } from '../../../lib/sanity/draft-mode';
import { stegaClean } from '@sanity/client/stega';
import { getArticleAlternates } from '../../../lib/articleAlternates';
import { getRussianArticlePaths } from '../../../lib/articlePaths';
export async function getStaticPaths() { return (await getRussianArticlePaths()).filter((entry: Awaited<ReturnType<typeof getRussianArticlePaths>>[number]) => entry.props.domain === 'farm'); }
const { slug } = Astro.params;
const { perspectiveCookie } = import.meta.env.MODE === 'preview' ? await getDraftModeProps(Astro.cookies) : { perspectiveCookie: undefined };
const article = await fetchSanity<ARTICLE_DETAIL_QUERY_RESULT>(ARTICLE_DETAIL_QUERY, { language: 'ru', primaryDomain: 'farm', slug }, perspectiveCookie);
if (!article || stegaClean(article.primaryDomain ?? '') !== 'farm') throw new Error(`Published article not found: ${slug}`);
const alternates = await getArticleAlternates(article, perspectiveCookie);
---
<ArticlePage article={article} now={new Date().toISOString().slice(0, 10)} alternates={alternates} />
