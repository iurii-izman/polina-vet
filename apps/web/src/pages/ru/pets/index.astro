---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ActionCard from '../../../components/ActionCard.astro';
import { route } from '../../../lib/i18n';
---

<BaseLayout title="Домашние животные" locale="ru">
  <section class="page-intro container"><p class="eyebrow">Домашние животные</p><h1>Домашние животные</h1><p class="lead">Практическая информация о здоровье собак и кошек: что проверить дома, когда не стоит ждать, как подготовиться к визиту и что важно для профилактики.</p></section>
  <section class="container action-grid">
    <ActionCard tone="urgent" eyebrow="Срочно" title="Животному плохо прямо сейчас?" description="Признаки, при которых лучше не откладывать получение ветеринарной помощи." action="Срочные признаки" href={route.petUrgent('ru')} />
    <ActionCard tone="pet" eyebrow="Подготовка" title="Подготовиться к визиту" description="Что записать, измерить и взять с собой." action="Открыть памятку" href={route.beforeVisit('ru')} />
    <ActionCard eyebrow="Профилактика" title="Профилактика" description="Вакцинация, паразиты и основные профилактические материалы." action="Смотреть материалы" href={route.knowledge('ru')} />
  </section>
  <section class="container section" aria-labelledby="pets-situations-title">
    <div class="section-heading"><div><p class="eyebrow">Ориентиры</p><h2 id="pets-situations-title">Частые ситуации</h2></div><p>Разделы будут пополняться материалами после проверки. Сейчас доступны срочный маршрут и памятка перед визитом.</p></div>
    <div class="context-grid">
      <div class="context-card"><h3>Симптомы и изменения состояния</h3><p>Материалы появятся после медицинской проверки.</p></div>
      <div class="context-card"><h3>Профилактика</h3><p>Вакцинация и паразиты — в разделе «Знания».</p></div>
      <div class="context-card"><h3>Подготовка к визиту</h3><p>Откройте практическую памятку перед обращением.</p></div>
      <div class="context-card"><h3>Когда не стоит ждать</h3><p>Откройте отдельный срочный маршрут для домашних животных.</p></div>
    </div>
  </section>
</BaseLayout>
