---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import PortableText from '../../../components/PortableText.astro';
import { route } from '../../../lib/i18n';
import { getPublicProfile } from '../../../lib/sanity/content';
import { sanityImageUrl } from '../../../lib/sanity/image';

const profile = await getPublicProfile();
const author = profile?.primaryAuthor;
const portraitUrl = author?.portrait ? sanityImageUrl(author.portrait, 720) : undefined;
---

<BaseLayout title="О Полине" locale="ru">
  <Breadcrumbs items={[{ label: 'О Полине' }]} />
  <section class="page-intro container">
    <p class="eyebrow">О Полине</p>
    <h1>О Полине</h1>
    <p class="lead">{author?.shortBio ?? 'Практические материалы для владельцев домашних и сельскохозяйственных животных, основанные на понятной маршрутизации и проверяемых источниках.'}</p>
  </section>
  <section class="container page-content">
    <div class="profile-grid">
      {portraitUrl && <figure class="profile-portrait"><img src={portraitUrl} alt={author?.portrait?.alt ?? ''} width={author?.portrait?.dimensions?.width ?? 720} height={author?.portrait?.dimensions?.height ?? 900} /></figure>}
      <div class="state-card profile-card"><p class="eyebrow">Профиль</p><h2>{author?.name ?? 'Полина'}</h2>{author?.role && <p>{author.role}</p>}{author?.position && <p>{author.position}</p>}
        {author?.education?.length ? <div class="profile-education"><h3>Образование</h3>{author.education.map((item) => <p><strong>{item.institution}</strong><br />{item.field}{item.qualification && <><br />{item.qualification}</>}</p>)}</div> : null}
      </div>
    </div>
    <h2>Почему я делаю этот сайт</h2>
    <p>Владельцу животного часто не нужен огромный медицинский справочник. Ему нужно понять, насколько ситуация серьёзна, что можно безопасно сделать сейчас, чего лучше не делать и какие сведения подготовить для врача.</p>
    <p>Для фермера важна ещё одна перспектива: иногда проблема одного животного связана с группой, условиями содержания, профилактикой или биобезопасностью.</p>
    <p>Именно под эти задачи и развивается POLINA VET.</p>
    <h2>Как я подхожу к работе</h2>
    <p>Мне близок практический подход: сначала понять, что действительно происходит с животным и какие данные способны изменить решение, а затем выбирать диагностику и лечение с учётом реальных условий.</p>
    <p>В сельской практике не всегда доступна расширенная диагностика или оборудование крупной клиники. Поэтому особенно важны хороший осмотр, правильная оценка риска, понятный план действий и контроль динамики.</p>
    {author?.bio?.length ? <div class="portable-profile"><p class="eyebrow">О подходе</p><PortableText value={author.bio} /></div> : null}
    <div class="empty-state"><h3>Материалы и источники</h3><p>Перейдите к разделу «Знания», чтобы следить за появлением проверенных материалов.</p><a class="text-link" href={route.knowledge('ru')}>Открыть «Знания» <span aria-hidden="true">→</span></a></div>
  </section>
</BaseLayout>
