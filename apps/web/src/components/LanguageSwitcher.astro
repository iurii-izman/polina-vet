---
import { localeNames, publishedLocales, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
  mobile?: boolean;
}

const { locale, mobile = false } = Astro.props;
const languages = ['ru', 'ro', 'uk'] as const;
---

{mobile ? (
  <div class="mobile-nav__languages">
    <p class="mobile-nav__label">Язык</p>
    <ul class="language-list">
      {languages.map((candidate) =>
        publishedLocales.includes(candidate) ? (
          <li aria-current={candidate === locale ? 'true' : undefined}>
            {localeNames[candidate]}
          </li>
        ) : (
          <li aria-disabled="true">{localeNames[candidate]} — нет опубликованной версии</li>
        ),
      )}
    </ul>
  </div>
) : (
  <details class="language-menu" data-language-menu>
    <summary aria-label="Выбрать язык" aria-expanded="false">
      {locale.toUpperCase()} <span aria-hidden="true">⌄</span>
    </summary>
    <div class="language-popover" aria-label="Доступные языки">
      <p>Язык</p>
      <ul class="language-list">
        {languages.map((candidate) =>
          publishedLocales.includes(candidate) ? (
            <li aria-current={candidate === locale ? 'true' : undefined}>{localeNames[candidate]}</li>
          ) : (
            <li aria-disabled="true">{localeNames[candidate]} — нет опубликованной версии</li>
          ),
        )}
      </ul>
    </div>
  </details>
)}

{!mobile && (
  <script>
    document.querySelectorAll<HTMLElement>('[data-language-menu]').forEach((menu) => {
      const details = menu as HTMLDetailsElement;
      const summary = details.querySelector('summary');
      const syncExpanded = () => summary?.setAttribute('aria-expanded', String(details.open));
      details.addEventListener('toggle', syncExpanded);
      syncExpanded();
    });
  </script>
)}
