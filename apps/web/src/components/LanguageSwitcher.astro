---
import { contextualAlternates, localeNames, ui, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
  mobile?: boolean;
  alternates?: Partial<Record<Locale, string | null>>;
}

const { locale, mobile = false, alternates } = Astro.props;
const languages = ['ru', 'ro', 'uk'] as const;
const strings = ui[locale];
const available = contextualAlternates({ pathname: Astro.url.pathname, locale, alternates });
const labelFor = (candidate: Locale) => candidate === locale ? localeNames[candidate] : `${localeNames[candidate]} — ${strings.unavailable}`;
---

{mobile ? (
  <div class="mobile-nav__languages">
    <p class="mobile-nav__label">{strings.language}</p>
    <ul class="language-list">
      {languages.map((candidate) =>
        available[candidate] ? (
          <li aria-current={candidate === locale ? 'true' : undefined}>
            {candidate === locale ? localeNames[candidate] : <a href={available[candidate]!}>{localeNames[candidate]}</a>}
          </li>
        ) : (
          <li aria-disabled="true">{labelFor(candidate)}</li>
        ),
      )}
    </ul>
  </div>
) : (
  <details class="language-menu" data-language-menu>
    <summary aria-label={strings.chooseLanguage} aria-expanded="false">
      {locale.toUpperCase()} <span aria-hidden="true">⌄</span>
    </summary>
    <div class="language-popover" aria-label={locale === 'ro' ? 'Limbi disponibile' : locale === 'uk' ? 'Доступні мови' : 'Доступные языки'}>
      <p>{strings.language}</p>
      <ul class="language-list">
        {languages.map((candidate) =>
          available[candidate] ? (
            <li aria-current={candidate === locale ? 'true' : undefined}>{candidate === locale ? localeNames[candidate] : <a href={available[candidate]!}>{localeNames[candidate]}</a>}</li>
          ) : (
            <li aria-disabled="true">{labelFor(candidate)}</li>
          ),
        )}
      </ul>
    </div>
  </details>
)}

{!mobile && (
  <script>
    document.querySelectorAll<HTMLElement>('[data-language-menu]').forEach((menu) => {
      const details = menu as HTMLDetailsElement;
      const summary = details.querySelector('summary');
      const syncExpanded = () => summary?.setAttribute('aria-expanded', String(details.open));
      details.addEventListener('toggle', syncExpanded);
      syncExpanded();
      details.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape' || !details.open) return;
        event.preventDefault();
        details.open = false;
        summary?.focus();
      });
    });
  </script>
)}
