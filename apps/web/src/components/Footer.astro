---
import { route, ui, type Locale } from '../lib/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const strings = ui[locale];
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <a class="brand" href={route.home(locale)}>POLINA <span>VET</span></a>
      <p>{strings.footerDescription}</p>
    </div>
    <nav aria-label={locale === 'ro' ? 'Navigare în subsol' : locale === 'uk' ? 'Навігація в нижньому колонтитулі' : 'Навигация в подвале'}>
      <a href={route.pets(locale)}>{strings.nav.pets}</a>
      <a href={route.farm(locale)}>{strings.nav.farm}</a>
      <a href={route.knowledge(locale)}>{strings.nav.knowledge}</a>
      <a href={route.about(locale)}>{strings.nav.about}</a>
      <a href={route.contact(locale)}>{strings.footerContact}</a>
      <a href={route.editorialPolicy(locale)}>{strings.footerPolicy}</a>
      <a href={route.urgent(locale)}>{strings.urgent}</a>
    </nav>
    <div>
      <p class="footer-boundary">{strings.footerBoundary}</p>
      <div class="footer-languages" aria-label={strings.language}>
        {(['ru', 'ro', 'uk'] as const).map((language) => <span aria-current={locale === language ? 'true' : undefined}>{language.toUpperCase()}</span>)}
      </div>
    </div>
  </div>
</footer>
