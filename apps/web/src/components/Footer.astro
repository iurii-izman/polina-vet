---
import { route, type Locale } from '../lib/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <a class="brand" href={route.home(locale)}>POLINA <span>VET</span></a>
      <p>Ветеринарная информация и практические материалы для владельцев животных и хозяйств.</p>
    </div>
    <nav aria-label="Навигация в подвале">
      <a href={route.pets(locale)}>Домашние животные</a>
      <a href={route.farm(locale)}>Ферма</a>
      <a href={route.knowledge(locale)}>Знания</a>
      <a href={route.about(locale)}>О Полине</a>
      <a href={route.contact(locale)}>Контакты и доступность</a>
      <a href={route.editorialPolicy(locale)}>Редакционная политика</a>
      <a href={route.urgent(locale)}>Срочно: что делать</a>
    </nav>
    <div>
      <p class="footer-boundary">POLINA VET не является круглосуточной экстренной службой.</p>
      <div class="footer-languages" aria-label="Языки">
        <span aria-current={locale === 'ru' ? 'true' : undefined}>RU</span>
        <span aria-disabled="true">RO — нет версии</span>
        <span aria-disabled="true">UK — нет версии</span>
      </div>
    </div>
  </div>
</footer>
