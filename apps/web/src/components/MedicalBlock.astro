---
import { medicalBlockId } from '../lib/medicalBlockId';
interface Props { value: { _type: string; _key?: string; title?: string; description?: string; text?: string; items?: string[] } }
const { value } = Astro.props;
const headings: Record<string, string> = { practicalActions: 'Что можно сделать', dontDoBlock: 'Чего не делать', redFlagCategory: 'Признаки для срочной помощи', checklist: 'Чек-лист', nextSteps: 'Следующие шаги', safetyNotice: 'Важное ограничение' };
const heading = value.title ?? headings[value._type] ?? 'Информация';
const kind = ['medical-block', value._type === 'safetyNotice' ? 'medical-block--safety' : value._type === 'redFlagCategory' ? 'medical-block--red-flag' : value._type === 'dontDoBlock' ? 'medical-block--dont-do' : ''].filter(Boolean).join(' ');
const id = medicalBlockId(value._type, value._key);
---
<section class={kind} aria-labelledby={id}>
  <h2 id={id}>{heading}</h2>
  {value.description && <p>{value.description}</p>}
  {value.text && <p>{value.text}</p>}
  {value.items && <ul>{value.items.map((item) => <li>{item}</li>)}</ul>}
</section>
