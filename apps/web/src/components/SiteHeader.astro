---
import LanguageSwitcher from './LanguageSwitcher.astro';
import MobileNav from './MobileNav.astro';
import UrgentAction from './UrgentAction.astro';
import { route, type Locale } from '../lib/i18n';
import { ui } from '../lib/i18n';
import { activePrimaryNavigation } from '../lib/navigationCurrent';

interface Props { locale: Locale; alternates?: Partial<Record<Locale, string | null>> }

const { locale, alternates } = Astro.props;
const strings = ui[locale];
const pathname = Astro.url.pathname;
const activeNavigation = activePrimaryNavigation(pathname, locale);
const nav = [
  ['pets', route.pets(locale), strings.nav.pets],
  ['farm', route.farm(locale), strings.nav.farm],
  ['knowledge', route.knowledge(locale), strings.nav.knowledge],
  ['about', route.about(locale), strings.nav.about],
  ['contact', route.contact(locale), strings.nav.contact],
] as const;
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={route.home(locale)} aria-label={strings.brandLabel}>POLINA <span>VET</span></a>
    <nav class="desktop-nav" aria-label={strings.nav.contact === 'Contact' ? 'Navigare principală' : strings.nav.contact === 'Контакты' ? 'Основная навигация' : 'Головна навігація'}>
      {nav.map(([key, href, label]) => <a href={href} aria-current={activeNavigation === key ? 'page' : undefined}>{label}</a>)}
    </nav>
    <div class="header-actions">
      <LanguageSwitcher locale={locale} alternates={alternates} />
      <UrgentAction locale={locale} />
    </div>
    <MobileNav locale={locale} pathname={pathname} alternates={alternates} />
  </div>
</header>
