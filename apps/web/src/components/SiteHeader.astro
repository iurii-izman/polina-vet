---
import LanguageSwitcher from './LanguageSwitcher.astro';
import MobileNav from './MobileNav.astro';
import UrgentAction from './UrgentAction.astro';
import { route, type Locale } from '../lib/i18n';

interface Props { locale: Locale }

const { locale } = Astro.props;
const pathname = Astro.url.pathname;
const nav = [
  [route.pets(locale), 'Домашние животные'],
  [route.farm(locale), 'Ферма'],
  [route.knowledge(locale), 'Знания'],
  [route.about(locale), 'О Полине'],
  [route.contact(locale), 'Контакты'],
] as const;
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={route.home(locale)} aria-label="POLINA VET — главная">POLINA <span>VET</span></a>
    <nav class="desktop-nav" aria-label="Основная навигация">
      {nav.map(([href, label]) => <a href={href} aria-current={pathname === href ? 'page' : undefined}>{label}</a>)}
    </nav>
    <div class="header-actions">
      <LanguageSwitcher locale={locale} />
      <UrgentAction locale={locale} />
    </div>
    <MobileNav locale={locale} pathname={pathname} />
  </div>
</header>
