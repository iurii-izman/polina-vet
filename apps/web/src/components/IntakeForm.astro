---
import BaseLayout from '../layouts/BaseLayout.astro';
import UrgentBoundary from './UrgentBoundary.astro';
import { route, type Locale } from '../lib/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const enabled = import.meta.env.PUBLIC_INTAKE_ENABLED === 'true';
const apiUrl = import.meta.env.PUBLIC_INTAKE_API_URL ?? '';
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
const privacyNoticeVersion = '1.0';
const copy = {
  ru: { eyebrow: 'Обращение', title: 'Оставить обращение', lead: 'Коротко опишите ситуацию — это поможет понять, какой следующий шаг нужен.', unavailable: 'Форма обращения пока не активирована. Доступные способы связи остаются на странице контактов.', pet: 'Домашнее животное', farm: 'Ферма / сельхозживотные', name: 'Имя', locality: 'Местность', address: 'Адрес (необязательно)', channel: 'Как с вами связаться', phone: 'Телефон', telegram: 'Telegram', contact: 'Телефон или @username', species: 'Вид животного', speciesOther: 'Уточните вид (необязательно)', reason: 'Причина обращения', reasonOther: 'Другое', summary: 'Кратко опишите ситуацию', onset: 'Когда началось (необязательно)', group: 'Масштаб', single: 'Одно животное', multiple: 'Несколько животных', count: 'Сколько животных затронуто (необязательно)', privacy: 'Я ознакомился(ась) с уведомлением об обработке персональных данных и согласен(на) на обработку предоставленных данных для рассмотрения обращения и связи со мной.', submit: 'Отправить обращение', success: 'Обращение получено.', reference: 'Номер обращения', safety: 'Это не подтверждение записи и не экстренный чат. Ответ не гарантируется немедленно. Если состояние кажется срочным, используйте срочный маршрут.', invalid: 'Проверьте отмеченные поля.', failed: 'Не удалось отправить обращение. Попробуйте позже или используйте доступный способ связи.', select: 'Выберите вариант' },
  ro: { eyebrow: 'Solicitare', title: 'Trimiteți o solicitare', lead: 'Descrieți pe scurt situația — acest lucru ajută la alegerea următorului pas.', unavailable: 'Formularul nu este încă activat. Metodele de contact disponibile rămân pe pagina de contact.', pet: 'Animal de companie', farm: 'Fermă / animale agricole', name: 'Nume', locality: 'Localitate', address: 'Adresă (opțional)', channel: 'Metoda preferată de contact', phone: 'Telefon', telegram: 'Telegram', contact: 'Telefon sau @username', species: 'Specia', speciesOther: 'Specificați specia (opțional)', reason: 'Motivul solicitării', reasonOther: 'Alt motiv', summary: 'Descrieți pe scurt situația', onset: 'Când a început (opțional)', group: 'Amploare', single: 'Un animal', multiple: 'Mai multe animale', count: 'Număr de animale afectate (opțional)', privacy: 'Am citit notificarea privind prelucrarea datelor cu caracter personal și consimt la prelucrarea datelor furnizate pentru examinarea solicitării și contactarea mea.', submit: 'Trimiteți solicitarea', success: 'Solicitarea a fost primită.', reference: 'Numărul solicitării', safety: 'Aceasta nu este o confirmare a unei programări și nu este un chat de urgență. Răspunsul imediat nu este garantat. Dacă situația pare urgentă, folosiți traseul urgent.', invalid: 'Verificați câmpurile indicate.', failed: 'Solicitarea nu a putut fi trimisă. Încercați mai târziu sau folosiți o metodă de contact disponibilă.', select: 'Alegeți' },
  uk: { eyebrow: 'Звернення', title: 'Залишити звернення', lead: 'Коротко опишіть ситуацію — це допоможе визначити наступний крок.', unavailable: 'Форма звернення ще не активована. Доступні способи зв’язку залишаються на сторінці контактів.', pet: 'Домашня тварина', farm: 'Ферма / сільськогосподарські тварини', name: 'Ім’я', locality: 'Місцевість', address: 'Адреса (необов’язково)', channel: 'Бажаний спосіб зв’язку', phone: 'Телефон', telegram: 'Telegram', contact: 'Телефон або @username', species: 'Вид тварини', speciesOther: 'Уточніть вид (необов’язково)', reason: 'Причина звернення', reasonOther: 'Інша причина', summary: 'Коротко опишіть ситуацію', onset: 'Коли почалося (необов’язково)', group: 'Масштаб', single: 'Одна тварина', multiple: 'Кілька тварин', count: 'Кількість тварин (необов’язково)', privacy: 'Я ознайомився(лася) з повідомленням про обробку персональних даних і погоджуюся на обробку наданих даних для розгляду звернення та зв’язку зі мною.', submit: 'Надіслати звернення', success: 'Звернення отримано.', reference: 'Номер звернення', safety: 'Це не підтвердження запису і не екстрений чат. Негайна відповідь не гарантується. Якщо ситуація здається терміновою, скористайтеся терміновим маршрутом.', invalid: 'Перевірте позначені поля.', failed: 'Не вдалося надіслати звернення. Спробуйте пізніше або скористайтеся доступним способом зв’язку.', select: 'Оберіть' },
} as const;
const t = copy[locale];
const reasons = ['sick', 'injury', 'vaccination_prevention', 'parasites', 'follow_up', 'prevention', 'vaccination_treatment', 'youngstock', 'reproduction', 'other'];
const species = ['dog', 'cat', 'cattle', 'sheep_goats', 'pigs', 'horse', 'poultry', 'other'];
const labels = {
  ru: { dog: 'собака', cat: 'кошка', cattle: 'КРС', sheep_goats: 'овцы / козы', pigs: 'свиньи', horse: 'лошадь', poultry: 'птица', other: 'другое', sick: 'заболевание', injury: 'травма', vaccination_prevention: 'вакцинация / профилактика', parasites: 'паразиты', follow_up: 'повторное обращение', prevention: 'профилактика', vaccination_treatment: 'вакцинация / лечение', youngstock: 'молодняк', reproduction: 'воспроизводство' },
  ro: { dog: 'câine', cat: 'pisică', cattle: 'bovine', sheep_goats: 'oi / capre', pigs: 'porci', horse: 'cal', poultry: 'păsări', other: 'altul', sick: 'boală', injury: 'traumă', vaccination_prevention: 'vaccinare / prevenție', parasites: 'paraziți', follow_up: 'urmărire', prevention: 'prevenție', vaccination_treatment: 'vaccinare / tratament', youngstock: 'tineret', reproduction: 'reproducere' },
  uk: { dog: 'собака', cat: 'кіт', cattle: 'ВРХ', sheep_goats: 'вівці / кози', pigs: 'свині', horse: 'кінь', poultry: 'птиця', other: 'інше', sick: 'захворювання', injury: 'травма', vaccination_prevention: 'вакцинація / профілактика', parasites: 'паразити', follow_up: 'повторне звернення', prevention: 'профілактика', vaccination_treatment: 'вакцинація / лікування', youngstock: 'молодняк', reproduction: 'відтворення' },
} as const;
const optionLabels = labels[locale];
---
<BaseLayout title={t.title} locale={locale} robots="noindex, nofollow, noarchive">
  <section class="page-intro container"><p class="eyebrow">{t.eyebrow}</p><h1>{t.title}</h1><p class="lead">{t.lead}</p><UrgentBoundary locale={locale} /></section>
  <section class="container content-width-section section">
    {!enabled ? <div class="empty-state"><h2>{t.unavailable}</h2><p>{t.safety}</p><div class="hero__actions"><a class="button" href={route.contact(locale)}>{locale === 'ro' ? 'Contact și disponibilitate' : locale === 'uk' ? 'Контакти та доступність' : 'Контакты и доступность'} →</a><a class="button button--secondary" href={route.urgent(locale)}>{locale === 'ro' ? 'Urgent' : locale === 'uk' ? 'Терміново' : 'Срочно'} →</a></div></div> : <form id="intake-form" class="intake-form" method="post" action="" onsubmit="return false;" novalidate data-api={apiUrl} data-locale={locale} data-invalid={t.invalid} data-failed={t.failed} data-success={t.success} data-reference={t.reference} data-privacy-notice-version={privacyNoticeVersion}>
      <div class="intake-notice"><strong>{t.safety}</strong></div>
      <fieldset><legend>{locale === 'ro' ? 'Contextul solicitării' : locale === 'uk' ? 'Контекст звернення' : 'Контекст обращения'}</legend><div class="intake-choice"><label><input type="radio" name="domain" value="PET" required checked> {t.pet}</label><label><input type="radio" name="domain" value="FARM"> {t.farm}</label></div></fieldset>
      <div class="intake-grid"><div class="field"><label for="name">{t.name}</label><input id="name" name="personName" maxlength="120" required></div><div class="field"><label for="locality">{t.locality}</label><input id="locality" name="locality" maxlength="120" required></div><div class="field"><label for="address">{t.address}</label><input id="address" name="address" maxlength="250"></div><div class="field"><label for="channel">{t.channel}</label><select id="channel" name="preferredContactChannel"><option value="phone">{t.phone}</option><option value="telegram">{t.telegram}</option></select></div><div class="field"><label for="contact">{t.contact}</label><input id="contact" name="contactValue" maxlength="160" required></div><div class="field"><label for="species">{t.species}</label><select id="species" name="species">{species.map((item) => <option value={item} data-pet={['dog','cat','other'].includes(item) ? 'true' : 'false'} data-farm={['cattle','sheep_goats','pigs','horse','poultry','other'].includes(item) ? 'true' : 'false'}>{optionLabels[item as keyof typeof optionLabels]}</option>)}</select></div><div class="field"><label for="speciesOther">{t.speciesOther}</label><input id="speciesOther" name="speciesOther" maxlength="80"></div><div class="field"><label for="reason">{t.reason}</label><select id="reason" name="reason">{reasons.map((item) => <option value={item} data-pet={['sick','injury','vaccination_prevention','parasites','follow_up','other'].includes(item) ? 'true' : 'false'} data-farm={['sick','prevention','vaccination_treatment','youngstock','reproduction','other'].includes(item) ? 'true' : 'false'}>{item === 'other' ? t.reasonOther : optionLabels[item as keyof typeof optionLabels] ?? item}</option>)}</select></div><div class="field"><label for="onset">{t.onset}</label><input id="onset" name="onset" maxlength="120"></div><div class="field farm-only"><label for="groupScope">{t.group}</label><select id="groupScope" name="groupScope"><option value="single">{t.single}</option><option value="multiple">{t.multiple}</option></select></div><div class="field farm-only"><label for="affectedCount">{t.count}</label><input id="affectedCount" name="affectedCount" type="number" min="1" max="1000000"></div></div>
      <div class="field"><label for="summary">{t.summary}</label><textarea id="summary" name="summary" maxlength="1000" rows="5" required></textarea></div>
      <label class="intake-check"><input type="checkbox" name="privacyAcknowledged" required> <span>{t.privacy} <a href={route.privacy(locale)}>{locale === 'ro' ? 'Citiți notificarea' : locale === 'uk' ? 'Прочитати повідомлення' : 'Ознакомиться с уведомлением'}</a></span></label><div class="caption">{privacyNoticeVersion} · {locale === 'ro' ? 'Notificare aprobată la 6 septembrie 2026.' : locale === 'uk' ? 'Повідомлення затверджено 6 вересня 2026 року.' : 'Уведомление утверждено 6 сентября 2026 года.'}</div><input type="hidden" name="privacyNoticeVersion" value={privacyNoticeVersion}>
      {turnstileSiteKey && <div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div>}
      <input name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="honeypot"><p id="intake-status" role="status" aria-live="polite"></p><button type="submit" class="button">{t.submit}</button>
    </form>}
  </section>
</BaseLayout>
{enabled && turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
{enabled && <script is:inline src="/intake-form.js" defer></script>}
