---
interface Props { sourceHref: string }
const { sourceHref } = Astro.props;
---

<section class="state-card" aria-labelledby="translation-title">
  <p class="eyebrow">Языковая версия</p>
  <h2 id="translation-title">Этот материал пока не переведён</h2>
  <p>Актуальная версия доступна на русском языке.</p>
  <a class="text-link" href={sourceHref}>Открыть русскую версию <span aria-hidden="true">→</span></a>
</section>
