---
import BaseLayout from '../layouts/BaseLayout.astro';
import UrgentBoundary from './UrgentBoundary.astro';
import { route, type Locale } from '../lib/i18n';
import { safeMapHref, safePhoneHref, safeTelegramHref, serviceModeLabels } from '../lib/profile';

interface Props {
  locale: Locale;
  page: 'home' | 'pets' | 'farm' | 'urgent' | 'petUrgent' | 'farmUrgent' | 'beforeVisit' | 'beforeVetArrives' | 'animalSick' | 'prepare' | 'groupProblem' | 'knowledge' | 'about' | 'contact';
  profile?: any;
}
const { locale, page, profile } = Astro.props;
const ro = locale === 'ro';
const uk = locale === 'uk';
const s = ro ? {
  homeTitle: 'Informații veterinare practice', homeEyebrow: 'Informații veterinare practice', homeH1: 'Ajutorul veterinar începe cu următorul pas potrivit', homeLead: 'Materiale practice pentru proprietarii animalelor de companie și ai animalelor din gospodărie: ce să verificați, când să nu așteptați și cum să vă pregătiți pentru un consult.', pets: 'Animale de companie', farm: 'Fermă', petTitle: 'Câini și pisici', farmTitle: 'Gospodărie și animale', urgent: 'Starea animalului pare urgentă?', choose: 'Alegeți contextul pentru a vedea următorul pas și materialele potrivite.', now: 'Ce este de făcut acum', tasks: 'De ce aveți nevoie?', sick: 'Animalul s-a îmbolnăvit', sickDesc: 'Începeți cu secțiunea potrivită pentru animalul dumneavoastră.', prevention: 'Prevenție', prep: 'Pregătire pentru consult', urgentTask: 'Situație urgentă', find: 'Găsiți informații', about: 'Despre Polina', contact: 'Contact și disponibilitate', policy: 'Politica editorială', knowledge: 'Cunoștințe', knowledgeTitle: 'Materiale veterinare', emptyTitle: 'Materiale verificate în limba română nu sunt încă publicate', empty: 'Această secțiune va fi completată după traducerea și verificarea materialelor. Puteți deschide versiunea rusă sau un traseu practic.', readRu: 'Deschideți versiunea rusă', core: 'Informații practice pentru sănătatea câinilor și pisicilor: ce să verificați acasă, când să nu așteptați, cum să vă pregătiți pentru consult și ce contează pentru prevenție.', farmLead: 'Materiale practice pentru proprietarii animalelor agricole: de la problema unui singur animal la prevenție, biosecuritate și pregătirea gospodăriei pentru sosirea medicului veterinar.', actionUrgent: 'Situația necesită o soluție rapidă?', actionPrep: 'Pregătiți-vă pentru consult', actionFarmPrep: 'Înainte de sosirea medicului veterinar', group: 'S-au îmbolnăvit mai multe animale', groupDesc: 'La îmbolnăvirea simultană este important să evaluați factorul comun și riscul pentru grup.', common: 'Situații frecvente', start: 'De unde să începeți', context: 'Contextul contează', petUrgentH1: 'Când nu trebuie să așteptați', petUrgentLead: 'Unele stări necesită o evaluare veterinară mai rapidă. Mai jos sunt semnele pentru care amânarea consultului este deosebit de nedorită.', farmUrgentH1: 'Situații urgente în gospodărie', farmUrgentLead: 'În unele situații este important să evaluați nu doar un animal, ci și riscul pentru grup, condițiile și un posibil factor comun.', safety: 'Important: absența semnelor enumerate nu exclude o problemă serioasă. Dacă starea se agravează sau vă îngrijorează, urmăriți dinamica, nu doar această listă.', do: 'Ce puteți face acum', dont: 'Ce este mai bine să nu faceți', prepare: 'Ce să pregătiți', beforeVisit: 'Cum să vă pregătiți pentru consultul cu un câine sau o pisică', beforeVisitLead: 'Câteva date pregătite din timp ajută la evaluarea situației.', beforeFarm: 'Cum să vă pregătiți pentru sosirea medicului veterinar', beforeFarmLead: 'Pregătiți animalul, spațiul și informațiile înainte de sosire.', contactH1: 'Contact și disponibilitate', aboutH1: 'Despre Polina', aboutLead: 'Un spațiu cu materiale practice pentru proprietarii animalelor de companie și ai animalelor din gospodărie.', groupH1: 'Mai multe animale s-au îmbolnăvit', groupLead: 'Începeți cu amploarea problemei, dinamica și schimbările comune din gospodărie.', animalSickH1: 'Animalul s-a îmbolnăvit', animalSickLead: 'Alegeți contextul. Acest traseu nu transformă automat o problemă generală într-o situație urgentă.', prepareH1: 'Pregătire pentru adresare', prepareLead: 'Alegeți tipul de adresare pentru a deschide lista potrivită.', policyFallback: 'Materialele au caracter informativ. Ele ajută la orientarea în situație, dar nu înlocuiesc evaluarea clinică individuală.'
} : uk ? {
  homeTitle: 'Практична ветеринарна інформація', homeEyebrow: 'Практична ветеринарна інформація', homeH1: 'Ветеринарна допомога починається з правильного наступного кроку', homeLead: 'Практичні матеріали для власників домашніх і сільськогосподарських тварин: що перевірити, коли не варто чекати та як підготуватися до звернення.', pets: 'Домашні тварини', farm: 'Ферма', petTitle: 'Собаки й коти', farmTitle: 'Господарство і тварини', urgent: 'Стан тварини здається терміновим?', choose: 'Оберіть контекст, щоб побачити відповідний наступний крок і матеріали.', now: 'Що робити зараз', tasks: 'Що вам потрібно?', sick: 'Тварина захворіла', sickDesc: 'Почніть із розділу для вашої тварини.', prevention: 'Профілактика', prep: 'Підготуватися до звернення', urgentTask: 'Термінова ситуація', find: 'Знайти інформацію', about: 'Про Поліну', contact: 'Контакти та доступність', policy: 'Редакційна політика', knowledge: 'Знання', knowledgeTitle: 'Ветеринарні матеріали', emptyTitle: 'Перевірені матеріали українською ще не опубліковані', empty: 'Цей розділ буде доповнено після перекладу та перевірки матеріалів. Ви можете відкрити російську версію або практичний маршрут.', readRu: 'Відкрити російську версію', core: 'Практична інформація про здоров’я собак і котів: що перевірити вдома, коли не варто чекати, як підготуватися до візиту та що важливо для профілактики.', farmLead: 'Практичні матеріали для власників сільськогосподарських тварин: від проблеми однієї тварини до профілактики, біобезпеки та підготовки господарства до приїзду ветеринара.', actionUrgent: 'Проблема потребує швидкого рішення?', actionPrep: 'Підготуватися до візиту', actionFarmPrep: 'Перед приїздом ветеринара', group: 'Захворіло кілька тварин', groupDesc: 'За одночасного захворювання важливо оцінити спільний фактор і ризик для групи.', common: 'Поширені ситуації', start: 'З чого почати', context: 'Контекст важливий', petUrgentH1: 'Коли не варто чекати', petUrgentLead: 'Деякі стани потребують швидшої ветеринарної оцінки. Нижче наведені ознаки, за яких відкладати звернення особливо небажано.', farmUrgentH1: 'Термінові ситуації в господарстві', farmUrgentLead: 'У деяких ситуаціях важливо оцінити не лише одну тварину, а й ризик для групи, умови та можливий спільний фактор.', safety: 'Важливо: відсутність перелічених ознак не виключає серйозної проблеми. Якщо стан погіршується або вас непокоїть, орієнтуйтеся на динаміку, а не лише на цей список.', do: 'Що можна зробити зараз', dont: 'Чого краще не робити', prepare: 'Що підготувати', beforeVisit: 'Як підготуватися до візиту із собакою чи котом', beforeVisitLead: 'Підготовлені заздалегідь відомості допоможуть оцінити ситуацію.', beforeFarm: 'Як підготуватися до приїзду ветеринара', beforeFarmLead: 'Підготуйте тварину, місце та інформацію до приїзду.', contactH1: 'Контакти та доступність', aboutH1: 'Про Поліну', aboutLead: 'Місце з практичними матеріалами для власників домашніх і сільськогосподарських тварин.', groupH1: 'Захворіло кілька тварин', groupLead: 'Почніть із масштабу проблеми, динаміки та спільних змін у господарстві.', animalSickH1: 'Тварина захворіла', animalSickLead: 'Оберіть контекст. Цей маршрут не перетворює загальну проблему автоматично на термінову ситуацію.', prepareH1: 'Підготовка до звернення', prepareLead: 'Оберіть тип звернення, щоб відкрити відповідний список.', policyFallback: 'Матеріали мають інформаційний характер. Вони допомагають зорієнтуватися в ситуації, але не замінюють індивідуальну клінічну оцінку.'
} : null;
const r = s ?? ({} as any);
if (!r.farmUrgentLead) r.farmUrgentLead = r.farmLead;
const description = page === 'pets' ? r.core : page === 'farm' ? r.farmLead : undefined;
const profileAuthor = profile?.primaryAuthor;
const phoneHref = safePhoneHref(profile?.contacts?.primaryPhone);
const telegramHref = safeTelegramHref(profile?.contacts?.telegramHandle);
const mapHref = safeMapHref(profile?.location?.mapUrl);
const modeLabels = ro ? { personalInquiry: 'Solicitare personală', appointment: 'Consult', fieldVisit: 'Deplasare' } : uk ? { personalInquiry: 'Особисте звернення', appointment: 'Прийом', fieldVisit: 'Виїзд' } : serviceModeLabels;
const checks = page === 'beforeVisit' ? (ro ? ['Notați când a început problema.', 'Pregătiți lista medicamentelor.', 'Luați rezultatele anterioare.', 'Filmați simptomul în siguranță.', 'Nu pregătiți analize „pentru orice eventualitate”.', 'Asigurați transportul în siguranță.', 'Anunțați despre un comportament dificil.'] : uk ? ['Запишіть, коли почалася проблема.', 'Підготуйте список препаратів.', 'Візьміть попередні результати.', 'Безпечно зніміть симптом на відео.', 'Не робіть аналізи «про всяк випадок».', 'Подбайте про безпечне транспортування.', 'Попередьте про складну поведінку.'] : []) : (ro ? ['Găsiți din timp animalul.', 'Pregătiți contenția sigură.', 'Pregătiți un ajutor.', 'Strângeți istoricul.', 'Pregătiți lista produselor folosite.', 'Dacă sunt bolnave mai multe animale, notați amploarea.', 'Pregătiți locul de lucru.', 'Respectați biosecuritatea.'] : uk ? ['Заздалегідь знайдіть тварину.', 'Підготуйте безпечну фіксацію.', 'Підготуйте помічника.', 'Зберіть історію.', 'Підготуйте список використаних препаратів.', 'Якщо захворіли кілька тварин, зафіксуйте масштаб.', 'Підготуйте робоче місце.', 'Подбайте про біобезпеку.'] : []);
---

{page === 'home' && <BaseLayout title={r.homeTitle} locale={locale}>
  <section class="hero container"><div><p class="eyebrow">{r.homeEyebrow}</p><h1>{r.homeH1}</h1><p class="lead">{r.homeLead}</p><div class="hero__actions"><a class="button" href={route.pets(locale)}>{r.pets} <span aria-hidden="true">→</span></a><a class="button button--secondary" href={route.farm(locale)}>{r.farm} <span aria-hidden="true">→</span></a></div></div><aside class="hero-panel"><span class="hero-panel__label">{r.start}</span><h2>{r.pets} {ro ? 'sau' : uk ? 'чи' : 'или'} {r.farm.toLowerCase()}?</h2><p>{r.choose}</p></aside></section>
  <section class="container gateway-grid" aria-label={r.choose}><a class="gateway gateway--pet" href={route.pets(locale)}><span class="eyebrow">{r.pets}</span><h2>{r.petTitle}</h2><p>{r.core}</p><span class="gateway__action">{ro ? 'Deschideți' : uk ? 'Перейти' : 'Перейти'} <b aria-hidden="true">→</b></span></a><a class="gateway gateway--farm" href={route.farm(locale)}><span class="eyebrow">{r.farm}</span><h2>{r.farmTitle}</h2><p>{r.farmLead}</p><span class="gateway__action">{ro ? 'Deschideți' : uk ? 'Перейти' : 'Перейти'} <b aria-hidden="true">→</b></span></a></section>
  <section class="container urgent-strip"><div class="urgent-strip__copy"><p class="eyebrow">{r.urgent}</p><h2>{r.urgent}</h2><p>{r.choose}</p></div><a class="button button--light" href={route.urgent(locale)}>{r.now} <span aria-hidden="true">→</span></a></section>
  <section class="container section"><p class="eyebrow">{r.start}</p><h2>{r.tasks}</h2><div class="task-grid"><a class="task-card" href={route.animalSick(locale)}><span class="task-card__title">{r.sick}</span><span class="task-card__description">{r.sickDesc}</span></a><a class="task-card" href={route.knowledge(locale)}><span class="task-card__title">{r.prevention}</span><span class="task-card__description">{r.empty}</span></a><a class="task-card" href={route.prepare(locale)}><span class="task-card__title">{r.prep}</span><span class="task-card__description">{r.beforeVisitLead}</span></a><a class="task-card" href={route.urgent(locale)}><span class="task-card__title">{r.urgentTask}</span><span class="task-card__description">{r.safety}</span></a><a class="task-card" href={route.knowledge(locale)}><span class="task-card__title">{r.find}</span><span class="task-card__description">{r.empty}</span></a></div></section>
  <section class="container section"><p class="eyebrow">POLINA VET</p><h2>{r.about}</h2><p class="lead">{r.aboutLead}</p><a class="text-link" href={route.about(locale)}>{r.about} <span aria-hidden="true">→</span></a></section>
  <section class="container section"><p class="eyebrow">{r.knowledge}</p><h2>{r.emptyTitle}</h2><a class="text-link" href={route.knowledge(locale)}>{r.knowledge} <span aria-hidden="true">→</span></a></section>
  <section class="container section contact-strip"><h2>{r.contact}</h2><a class="button" href={route.contact(locale)}>{r.contact} <span aria-hidden="true">→</span></a></section>
</BaseLayout>}

{page === 'pets' && <BaseLayout title={r.pets} description={description} locale={locale}><section class="page-intro container"><p class="eyebrow">{r.pets}</p><h1>{r.pets}</h1><p class="lead">{r.core}</p></section><section class="container action-grid"><a class="action-card action-card--urgent" href={route.petUrgent(locale)}><p class="eyebrow">{r.urgent}</p><h2>{r.urgent}</h2><p>{r.actionUrgent}</p><span class="action-card__link">{r.now} →</span></a><a class="action-card" href={route.beforeVisit(locale)}><p class="eyebrow">{r.prep}</p><h2>{r.prep}</h2><p>{r.beforeVisitLead}</p><span class="action-card__link">{r.beforeVisit} →</span></a><a class="action-card" href={route.knowledge(locale)}><p class="eyebrow">{r.prevention}</p><h2>{r.prevention}</h2><p>{r.empty}</p><span class="action-card__link">{r.knowledge} →</span></a></section><section class="container section"><p class="eyebrow">{r.start}</p><h2>{r.common}</h2><div class="context-grid">{[r.sick, r.prevention, r.prep, r.urgent].map((item) => <div class="context-card"><h3>{item}</h3><p>{r.empty}</p></div>)}</div></section></BaseLayout>}

{page === 'farm' && <BaseLayout title={r.farm} description={description} locale={locale}><section class="page-intro container farm-intro"><p class="eyebrow">{r.farm}</p><h1>{r.farmTitle}</h1><p class="lead">{r.farmLead}</p></section><section class="container action-grid farm-actions"><a class="action-card action-card--urgent" href={route.farmUrgent(locale)}><p class="eyebrow">{r.urgent}</p><h2>{r.actionUrgent}</h2><p>{r.farmUrgentLead}</p><span class="action-card__link">{r.now} →</span></a><a class="action-card action-card--group" href={route.groupProblem(locale)}><p class="eyebrow">{r.group}</p><h2>{r.group}</h2><p>{r.groupDesc}</p><span class="action-card__link">{r.group} →</span></a><a class="action-card" href={route.beforeVetArrives(locale)}><p class="eyebrow">{r.prep}</p><h2>{r.actionFarmPrep}</h2><p>{r.beforeFarmLead}</p><span class="action-card__link">{r.beforeFarm} →</span></a><a class="action-card" href={route.knowledge(locale)}><p class="eyebrow">{r.prevention}</p><h2>{r.prevention}</h2><p>{r.empty}</p><span class="action-card__link">{r.knowledge} →</span></a></section><section class="container section"><p class="eyebrow">{r.start}</p><h2>{r.context}</h2><div class="context-grid">{[r.sick, r.group, r.prevention, r.actionFarmPrep].map((item) => <div class="context-card"><h3>{item}</h3><p>{r.groupDesc}</p></div>)}</div></section></BaseLayout>}

{page === 'urgent' && <BaseLayout title={r.urgent} locale={locale}><section class="page-intro container"><p class="eyebrow">{r.urgent}</p><h1>{r.urgent}</h1><p class="lead">{r.choose}</p><UrgentBoundary locale={locale} /></section><section class="container gateway-grid"><a class="gateway gateway--pet" href={route.petUrgent(locale)}><span class="eyebrow">{r.pets}</span><h2>{r.petTitle}</h2><span class="gateway__action">{r.now} →</span></a><a class="gateway gateway--farm" href={route.farmUrgent(locale)}><span class="eyebrow">{r.farm}</span><h2>{r.farmTitle}</h2><span class="gateway__action">{r.now} →</span></a></section></BaseLayout>}

{(page === 'petUrgent' || page === 'farmUrgent') && <BaseLayout title={page === 'petUrgent' ? r.petUrgentH1 : r.farmUrgentH1} locale={locale}><section class="page-intro container urgent-page"><p class="eyebrow">{page === 'petUrgent' ? r.pets : r.farm} · {r.urgent}</p><h1>{page === 'petUrgent' ? r.petUrgentH1 : r.farmUrgentH1}</h1><p class="lead">{page === 'petUrgent' ? r.petUrgentLead : r.farmUrgentLead}</p><UrgentBoundary locale={locale} /></section><aside class={`container urgent-safety-notice urgent-safety-notice--${page === 'petUrgent' ? 'pet' : 'farm'}`}><p>{r.safety}</p></aside><section class="container section"><div class="context-grid">{(page === 'petUrgent' ? (ro ? ['Respirație', 'Conștiență și neurologie', 'Sângerare și traumă', 'Abdomen și vărsături', 'Urinare', 'Stare generală'] : ['Дихання', 'Свідомість і неврологія', 'Кровотеча та травма', 'Живіт і блювання', 'Сечовипускання', 'Загальний стан']) : (ro ? ['Fătare', 'Balonare / abdomen', 'Animal culcat', 'Respirație', 'Traumă / sângerare', 'Mai multe animale'] : ['Родова діяльність', 'Здуття / живіт', 'Тварина не встає', 'Дихання', 'Травма / кровотеча', 'Кілька тварин'])).map((item) => <div class="context-card"><h2>{item}</h2><p>{r.safety}</p></div>)}</div></section><section class="container section do-dont-grid"><div class="state-card"><h2>{r.do}</h2><p>{r.prepare}. {r.safety}</p></div><div class="state-card"><h2>{r.dont}</h2><p>{r.safety}</p></div></section><section class="container section"><div class="empty-state"><h2>{r.prepare}</h2><p>{r.safety}</p><a class="button" href={route.contact(locale)}>{r.contact} →</a></div></section></BaseLayout>}

{(page === 'beforeVisit' || page === 'beforeVetArrives') && <BaseLayout title={page === 'beforeVisit' ? r.beforeVisit : r.beforeFarm} locale={locale}><section class="page-intro container"><p class="eyebrow">{r.prep}</p><h1>{page === 'beforeVisit' ? r.beforeVisit : r.beforeFarm}</h1><p class="lead">{page === 'beforeVisit' ? r.beforeVisitLead : r.beforeFarmLead}</p></section><section class="container page-content section"><ol class="checklist">{checks.map((item) => <li>{item}</li>)}</ol><button class="button button--secondary" type="button" data-print-checklist>{ro ? 'Imprimați lista' : uk ? 'Роздрукувати пам’ятку' : 'Распечатать памятку'}</button></section></BaseLayout>}

{page === 'knowledge' && <BaseLayout title={r.knowledgeTitle} robots="noindex,follow" locale={locale}><section class="page-intro container"><p class="eyebrow">{r.knowledge}</p><h1>{r.knowledgeTitle}</h1><p class="lead">{r.empty}</p></section><section class="container page-content section"><div class="empty-state"><h2>{r.emptyTitle}</h2><p>{r.empty}</p><div class="empty-state__actions"><a class="button" href="/ru/knowledge/">{r.readRu} <span aria-hidden="true">→</span></a><a class="button button--secondary" href={route.pets(locale)}>{r.pets}</a></div></div></section></BaseLayout>}

{page === 'animalSick' && <BaseLayout title={r.animalSickH1} locale={locale}><section class="page-intro container"><p class="eyebrow">{r.sick}</p><h1>{r.animalSickH1}</h1><p class="lead">{r.animalSickLead}</p></section><section class="container gateway-grid task-router-grid"><a class="gateway gateway--pet" href={route.pets(locale)}><h2>{r.pets}</h2><span class="gateway__action">{r.pets} →</span></a><a class="gateway gateway--farm" href={route.farm(locale)}><h2>{r.farm}</h2><span class="gateway__action">{r.farm} →</span></a></section><section class="container section task-router-urgent"><a class="button button--secondary" href={route.urgent(locale)}>{r.urgent} →</a></section></BaseLayout>}

{page === 'prepare' && <BaseLayout title={r.prepareH1} locale={locale}><section class="page-intro container"><p class="eyebrow">{r.prep}</p><h1>{r.prepareH1}</h1><p class="lead">{r.prepareLead}</p></section><section class="container gateway-grid task-router-grid"><a class="gateway gateway--pet" href={route.beforeVisit(locale)}><h2>{r.beforeVisit}</h2><span class="gateway__action">{r.beforeVisit} →</span></a><a class="gateway gateway--farm" href={route.beforeVetArrives(locale)}><h2>{r.beforeFarm}</h2><span class="gateway__action">{r.beforeFarm} →</span></a></section></BaseLayout>}

{page === 'groupProblem' && <BaseLayout title={r.groupH1} locale={locale}><section class="page-intro container"><p class="eyebrow">{r.farm} · {r.group}</p><h1>{r.groupH1}</h1><p class="lead">{r.groupLead}</p></section><section class="container section"><div class="farm-risk-block"><h2>{r.start}</h2><p>{r.groupDesc}</p><p>{r.safety}</p><a class="button" href={route.farmUrgent(locale)}>{r.urgent} →</a><a class="button button--secondary" href={route.beforeVetArrives(locale)}>{r.beforeFarm} →</a></div></section></BaseLayout>}

{page === 'about' && <BaseLayout title={r.aboutH1} locale={locale}><section class="page-intro container"><p class="eyebrow">{r.about}</p><h1>{r.aboutH1}</h1><p class="lead">{r.aboutLead}</p></section><section class="container page-content section"><div class="state-card profile-card"><h2>{profileAuthor?.name ?? 'Polina'}</h2>{profileAuthor?.role && <p>{profileAuthor.role}</p>}{profileAuthor?.position && <p>{profileAuthor.position}</p>}</div><h2>{r.context}</h2><p>{r.aboutLead}</p><p>{r.policyFallback}</p></section></BaseLayout>}

{page === 'contact' && <BaseLayout title={r.contactH1} locale={locale}><section class="page-intro container"><p class="eyebrow">{r.contact}</p><h1>{r.contactH1}</h1><p class="lead">{r.contact}</p><UrgentBoundary locale={locale} /></section><section class="container page-content section contact-page" aria-labelledby="contact-methods-title"><h2 id="contact-methods-title">{r.contact}</h2><div class="contact-grid">{profile?.contacts?.primaryPhone && <div class="state-card"><p class="eyebrow">{ro ? 'Telefon' : uk ? 'Телефон' : 'Телефон'}</p><h3>{profile.contacts.primaryPhone}</h3>{phoneHref && <a class="button" href={phoneHref}>{ro ? 'Sunați' : uk ? 'Зателефонувати' : 'Позвонить'}</a>}</div>}{profile?.contacts?.telegramHandle && <div class="state-card"><p class="eyebrow">Telegram</p><h3>{profile.contacts.telegramHandle}</h3>{telegramHref && <a class="button" href={telegramHref} target="_blank" rel="noopener noreferrer">{ro ? 'Scrieți' : uk ? 'Написати' : 'Написать'}</a>}</div>}{profile?.location?.label && <div class="state-card"><p class="eyebrow">{ro ? 'Loc' : uk ? 'Місце' : 'Место'}</p><h3>{profile.location.label}</h3>{mapHref && <a class="button button--secondary" href={mapHref} target="_blank" rel="noopener noreferrer">{ro ? 'Deschideți harta' : uk ? 'Відкрити карту' : 'Открыть на карте'}</a>}</div>}{profile?.serviceModes?.length && <div class="state-card"><p class="eyebrow">{ro ? 'Formate' : uk ? 'Формати звернення' : 'Форматы обращения'}</p><ul class="contact-list">{profile.serviceModes.map((mode: string) => modeLabels[mode as keyof typeof modeLabels] ? <li>{modeLabels[mode as keyof typeof modeLabels]}</li> : null)}</ul></div>}</div></section></BaseLayout>}

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-print-checklist]').forEach((button) => button.addEventListener('click', () => window.print()));
</script>
