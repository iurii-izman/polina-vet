---
import ArticleBody from './ArticleBody.astro';
import ArticleNextSteps from './ArticleNextSteps.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import MedicalMeta from './MedicalMeta.astro';
import SourceList from './SourceList.astro';
import StaleHighRiskState from './StaleHighRiskState.astro';
import WithdrawnState from './WithdrawnState.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { articleRoute } from '../lib/articleRoute';
import { getArticlePresentation } from '../lib/articlePresentation';
import { route, ui, type Locale } from '../lib/i18n';
import { stegaClean } from '@sanity/client/stega';
const { article, now, alternates: articleAlternates } = Astro.props;
const locale = stegaClean(article.language ?? 'ru') as Locale;
const domain = stegaClean(article.primaryDomain ?? '') as 'pet' | 'farm' | 'shared';
const strings = ui[locale];
const presentation = getArticlePresentation(article, now);
const safetyState = presentation.safetyState;
const replacementHref = article.replacement ? articleRoute({ language: article.replacement.language, primaryDomain: article.replacement.primaryDomain, slug: article.replacement.slug }) : (domain === 'farm' ? route.farmUrgent(locale) : domain === 'pet' ? route.petUrgent(locale) : route.urgent(locale));
const pageTitle = article.seoTitle ?? article.title;
const domainLabel = domain === 'farm' ? strings.nav.farm : domain === 'pet' ? strings.nav.pets : strings.nav.knowledge;
const domainHref = domain === 'farm' ? route.farm(locale) : domain === 'pet' ? route.pets(locale) : route.knowledge(locale);
const alternates = articleAlternates ?? ({ [locale]: Astro.url.pathname } as Partial<Record<Locale, string | null>>);
---
<BaseLayout title={pageTitle} description={presentation.description} robots={presentation.robots} locale={locale} alternates={alternates}>
  <Breadcrumbs locale={locale} items={[{ label: domainLabel, href: domainHref }, { label: article.title }]} />
  <article class="medical-article container">
    <p class="eyebrow">{domainLabel}</p>
    <h1>{article.title}</h1>
    {presentation.showMedicalContent && <p class="lead medical-article__summary">{article.summary}</p>}
    {safetyState === 'CURRENT' ? <>
      <MedicalMeta domain={domain} species={article.species} owner={article.medicalOwner} reviewedBy={article.reviewedBy} lastMedicalReview={article.lastMedicalReview} sourceCount={article.sources?.length ?? 0} />
      <ArticleBody body={article.body} />
      <SourceList sources={article.sources} />
      <ArticleNextSteps locale={locale} domain={domain} />
    </> : safetyState === 'STALE_HIGH_RISK' ? <StaleHighRiskState replacementHref={replacementHref} /> : <WithdrawnState replacementHref={replacementHref} />}
  </article>
</BaseLayout>
