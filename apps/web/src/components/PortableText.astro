---
import { PortableText } from 'astro-portabletext';
import type { TypedObject } from 'astro-portabletext/types';

import type { Page } from '../lib/sanity/sanity.types';
import SafePortableTextLink from './SafePortableTextLink.astro';

interface Props {
  value: Page['body'] | TypedObject[] | null | undefined;
}

const { value } = Astro.props;
---

{value?.length ? <PortableText value={value as NonNullable<Page['body']>} components={{ mark: { link: SafePortableTextLink } }} /> : null}
