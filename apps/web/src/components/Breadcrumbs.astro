---
interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
  locale?: 'ru' | 'ro' | 'uk';
}

const { items, locale = 'ru' } = Astro.props;
const ariaLabel = locale === 'ro' ? 'Firimituri de navigare' : locale === 'uk' ? 'Навігаційний ланцюжок' : 'Хлебные крошки';
---

{items.length > 0 && (
  <nav class="breadcrumbs" aria-label={ariaLabel}>
    <ol>
      {items.map((item, index) => (
        <li>
          {item.href && index < items.length - 1 ? <a href={item.href}>{item.label}</a> : <span aria-current={index === items.length - 1 ? 'page' : undefined}>{item.label}</span>}
        </li>
      ))}
    </ol>
  </nav>
)}
